						</v:var>	
						<v:var name="FSRefClkRcChkAPPowerOn" type="BOOLEAN">
						  <a:a name="DESC" 
							   value="EN: Preprocessor switch to disable / enable the function(Fail safe reference clock:Rc clock check Ap clock)."/>
						  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
							   type="IMPLEMENTATIONCONFIGCLASS">
							<icc:v vclass="PreCompile">VariantLinkTime</icc:v>
