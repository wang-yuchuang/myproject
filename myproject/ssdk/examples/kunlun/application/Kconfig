comment "Application Options"

rsource "boot_splash/Kconfig"

menuconfig APP_LAUNCHER
    bool "launcher application"
    default n

config APP_LAUNCHER_DEBUG
    bool "app launcher debug"
    depends on APP_LAUNCHER
    default n

if APP_LAUNCHER
rsource "launcher/Kconfig"
rsource "arbitrator/Kconfig"
endif # APP_LAUNCHER

