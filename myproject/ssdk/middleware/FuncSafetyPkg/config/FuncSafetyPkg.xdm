							  <a:a name="UUID" 
								   value="ECUC:d596f059-d21f-46fa-8c62-8eae8ff3d68d"/>
							  <a:da name="DEFAULT" value='0xffffffff'/>
							  <a:da name="INVALID" type="Range">
								<a:tst expr="&lt;=0xff"/>
								<a:tst expr="&gt;=0x0a"/>
							  </a:da>
							</v:var>
