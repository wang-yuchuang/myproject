#!/bin/sh

###added by Jimmy for fault check: if mmcblk0p1 is a file, should remove it before mount
if [ -f "/media/mmcblk0p1" ]; then
    rm /media/mmcblk0p1 -f
fi

#now handle USB update
EXTENS_MARK_FILE="/var/.ext_mark"
IS_NEED_CALIBTATE=0

#added by Jimmy 20201107 because app_update need libpub
NCCU_RUN_PATH="/app"
export NCCU_RUN_PATH
NCCU_DATA_PATH="/data"
export NCCU_DATA_PATH
LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/lib:$NCCU_RUN_PATH/lib:$NCCU_RUN_PATH/extensions
export LD_LIBRARY_PATH

function wait_appupdt_exe_done()
{
    FILENAME_APPUDDT_FLAG="/opt/appdata/data/firmwareupdt.flag"
    if [ -f $FILENAME_APPUDDT_FLAG ]; then
        wait=1
        while [ $wait -le 300 ] #max wait 30sec
        do
            if [ ! -f $FILENAME_APPUDDT_FLAG ]; then
                #echo "app_udate done........"
                break
            #else
            #    echo "waiting app update.........."
            fi
            let wait++
            usleep 100000
        done
    #else
    #    echo "app_udate flag not found, so continue........"
    fi
}

echo "[BOOT] startrun: entered, EXTENS_MARK_FILE=$EXTENS_MARK_FILE"
    if [ -f $EXTENS_MARK_FILE ]; then
    echo "[BOOT] startrun: EXTENS_MARK_FILE exists, skip upgrade detection"
    echo
    echo Finished reboot, now staring app...
    echo
    rm $EXTENS_MARK_FILE -f
    IS_NEED_CALIBTATE=1
    else
    echo "[BOOT] startrun: EXTENS_MARK_FILE not found, checking USB/SD..."
    IS_FOUND_UPDTFILE=0
    IS_USBDISK_DEV_FILE_EXIST=`ls /dev/sd* 2>/dev/null | wc -l`
    IS_SDCARD_DEV_FILE_EXIST=`ls /dev/mmcblk[1-9]* 2>/dev/null | wc -l`
    echo "[BOOT] startrun: USB devs=$IS_USBDISK_DEV_FILE_EXIST, SD devs=$IS_SDCARD_DEV_FILE_EXIST"
    if [ $IS_USBDISK_DEV_FILE_EXIST -gt 0 ]; then
        #jimmy: as long as dev detected should be able to calibrate
        IS_NEED_CALIBTATE=1
        USBDISK_DIR=`/bin/mount | grep '/media/sd' | cut -d ' ' -f 3`
        if [[ -n $USBDISK_DIR ]]; then
            # echo
            # echo "!!!!find the USB files => ($USBDISK_DIR)!!!"
            # echo        
            #if [ -f "$USBDISK_DIR/app_nccu.tar.gz" ] && [ -f "$USBDISK_DIR/pkg.sum" ]; then
                # echo
                # echo "!!!!find the pkg file in USB files => ($USBDISK_DIR)!!!"
                # echo
                #IS_FOUND_UPDTFILE=11111
            #fi
            IS_FOUND_UPDTFILE=11111
        fi
    fi

    if [ $IS_FOUND_UPDTFILE -le 0 ]; then
        if [ $IS_SDCARD_DEV_FILE_EXIST -gt 0 ]; then
            #jimmy: as long as dev detected should be able to calibrate
            IS_NEED_CALIBTATE=1
            SDCARD_DIR=`/bin/mount | grep '/media/mmc' | cut -d ' ' -f 3`
            if [[ -n $SDCARD_DIR ]]; then
                # echo
                # echo "!!!!find the SD dir => ($SDCARD_DIR)!!!"
                # echo        
                #if [ -f "$SDCARD_DIR/app_nccu.tar.gz" ] && [ -f "$SDCARD_DIR/pkg.sum" ]; then
                    # echo
                    # echo "!!!!find the pkg file in SD dir => ($SDCARD_DIR)!!!"
                    # echo
                    #IS_FOUND_UPDTFILE=22222
                #fi
                IS_FOUND_UPDTFILE=22222
            fi
        fi
    fi
fi
	echo "[BOOT] startrun: IS_FOUND_UPDTFILE=$IS_FOUND_UPDTFILE, IS_NEED_CALIBTATE=$IS_NEED_CALIBTATE"
    if [ $IS_FOUND_UPDTFILE -gt 0 ]; then
        echo
        echo "Now find the USB/SD device (1111-USB, 2222-SD) -> ($IS_FOUND_UPDTFILE), please wait for upgrading..."
        echo
        echo "[BOOT] startrun: running app_update -fwupdt (upgrade mode)"
        /app/bin/app_update -qws -nokeyboard -fwupdt
    elif [ $IS_NEED_CALIBTATE -gt 0 ]; then
        echo
        echo "Now find USB/SD device, but not sure for update file, will still entering updating..."
        echo
        echo "[BOOT] startrun: running app_update -fwupdt (calibration mode)"
        /app/bin/app_update -qws -nokeyboard -fwupdt
    else
        echo "[BOOT] startrun: no upgrade device, proceed to run_app"
        wait_appupdt_exe_done
    fi

#add by lpl when is nfs-debug mode , no need CALIBTATE
if [ "$1" == "NO_NEED_CALIBTATE" ];then
    IS_NEED_CALIBTATE=0
fi

#/app/run_app -debug

echo "[BOOT] startrun: calling /app/run_app"
/app/run_app $IS_NEED_CALIBTATE