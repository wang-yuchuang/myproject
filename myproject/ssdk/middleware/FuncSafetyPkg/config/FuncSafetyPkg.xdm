                    <v:lst name="SemInterruptMonitorConfiguration" type="MAP">
                      <a:da name="MIN" value="0"/>
                      <v:ctr name="SemInterruptMonitorConfiguration" type="IDENTIFIABLE">
                        <a:a name="DESC" 
                             value="EN: Configuration of monitoring sem interrupt."/>
                        <a:a name="UUID" 
                             value="ECUC:f85f480f-fee7-4a00-a99a-4aede301e705"/>
                        <v:var name="SemIntOut0" type="INTEGER">
                          <a:a name="DESC" 
                               value="EN: Combined with SemIntOut1 to generate PAD interrupt,sem interrupt input status range:0~318,319 is invalid status and default is an invalid status,please refer to the manual for details."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                               type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                          <a:a name="SCOPE" value="ECU"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" 
                               value="ECUC:d596f059-d21f-46fa-8c62-8eae8ff3d68d"/>
                          <a:da name="DEFAULT" value='319'/>					  
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=319"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                        </v:var>
                        <v:var name="SemIntOut1" type="INTEGER">
                          <a:a name="DESC" 
                               value="EN: Combined with SemIntOut0 to generate PAD interrupt,sem interrupt input status range:0~318,319 is invalid status and default is an invalid status,please refer to the manual for details."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                               type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                          <a:a name="SCOPE" value="ECU"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" 
                               value="ECUC:d596f059-d21f-46fa-8c62-8eae8ff3d68d"/>
                          <a:da name="DEFAULT" value='319'/>							  
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=319"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                        </v:var>	
                        <v:var name="SemIntOut2" type="INTEGER">
                          <a:a name="DESC" 
                               value="EN: Interrupt to CPU,sem interrupt input status range:0~318,319 is invalid status and default is an invalid status,please refer to the manual for details."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                               type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                          <a:a name="SCOPE" value="ECU"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" 
                               value="ECUC:d596f059-d21f-46fa-8c62-8eae8ff3d68d"/>
                          <a:da name="DEFAULT" value='319'/>							  
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=319"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                        </v:var>	
                        <v:var name="SemIntOut3" type="INTEGER">
                          <a:a name="DESC" 
                               value="EN: Interrupt to reset,sem interrupt input status range:0~318,319 is invalid status and default is an invalid status,please refer to the manual for details."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                               type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                          <a:a name="SCOPE" value="ECU"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" 
                               value="ECUC:d596f059-d21f-46fa-8c62-8eae8ff3d68d"/>
                          <a:da name="DEFAULT" value='319'/>							  
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=319"/>
                            <a:tst expr="&gt;=0"/>
                          </a:da>
                        </v:var>																				
                      </v:ctr>
                    </v:lst>					
                    </v:ctr>
					<v:ctr name="DualCoreLockStepInjectErrConfigSet" type="IDENTIFIABLE">
						<a:a name="ENABLE" type="XPath" expr="(node:value(../SelfTestPowerOn) = &quot;true&quot; and               
						                                      node:value(../SelfTestPowerOnOptions/DualCoreLockStepInjectErrorPowerOn)= &quot;true&quot;) or 
															 (node:value(../SelfTestPeriodic) = &quot;true&quot; and               
						                                      node:value(../SelfTestPeriodicOptions/DualCoreLockStepInjectErrorPeriodic)= &quot;true&quot;) "/>
						<v:ctr name="DualCoreLockStepInjectErr" type="IDENTIFIABLE">
							<a:a name="DESC" 
								value="EN: This container contains configurations for injecting error on dual core lock step."/>
							<a:a name="UUID" 
								value="ECUC:62eb25f3-28ac-452e-a2fa-0f92357c16a6"/>			
						  <v:var name="DualCore_LockStep_CompareFail_NotDetectedNotification" type="FUNCTION-NAME">
							<a:a name="DESC" 
							   value="EN: Definition of the Callback function for not detecting according interrupt status after injecting error on dual core lock step."/>
							<a:a name="IMPLEMENTATIONCONFIGCLASS" 
								type="IMPLEMENTATIONCONFIGCLASS">
								<icc:v mclass="PostBuild">VariantPostBuild</icc:v>
								<icc:v mclass="PreCompile">VariantPreCompile</icc:v>
								<icc:v vclass="PostBuild">VariantPostBuild</icc:v>
								<icc:v vclass="PreCompile">VariantPreCompile</icc:v>
							</a:a>
							<a:a name="OPTIONAL" value="true"/>
							<a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
							<a:a name="POSTBUILDVARIANTVALUE" value="true"/>
							<a:a name="SCOPE" value="LOCAL"/>
							<a:a name="SYMBOLICNAMEVALUE" value="false"/>
							<a:a name="UUID" 
								value="ECUC:44bb38ac-d409-4b1d-96be-ec84466c1019"/>
							<a:da name="DEFAULT" value="NULL_PTR"/>
							<a:da name="ENABLE" value="false"/>
						  </v:var>															  
						</v:ctr>							
                      </v:ctr>	
					<v:ctr name="SocTempMonitorTstConfigSet" type="IDENTIFIABLE">					
					    <a:a name="ENABLE" type="XPath" expr="node:value(../SelfTestPowerOn) = &quot;true&quot; and
						                                      node:value(../SelfTestPowerOnOptions/SocTempMonitorPowerOn)= &quot;true&quot;"/>
						<v:ctr name="SocTempMonitorTst" type="IDENTIFIABLE">
							<a:a name="DESC" 
								value="EN: This container contains configurations for setting over-heat threshold of SOC temperature monitor."/>
							<a:a name="UUID" 
								value="ECUC:62eb25f3-28ac-452e-a2fa-0f92357c16a6"/>			
						  <v:var name="SocTempOverHeatInt_NotDetectedNotification" type="FUNCTION-NAME">
							<a:a name="DESC" 
							   value="EN: Definition of the Callback function."/>
							<a:a name="IMPLEMENTATIONCONFIGCLASS" 
								type="IMPLEMENTATIONCONFIGCLASS">
								<icc:v mclass="PostBuild">VariantPostBuild</icc:v>
								<icc:v mclass="PreCompile">VariantPreCompile</icc:v>
								<icc:v vclass="PostBuild">VariantPostBuild</icc:v>
								<icc:v vclass="PreCompile">VariantPreCompile</icc:v>
							</a:a>
							<a:a name="OPTIONAL" value="true"/>
							<a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
							<a:a name="POSTBUILDVARIANTVALUE" value="true"/>
							<a:a name="SCOPE" value="LOCAL"/>
							<a:a name="SYMBOLICNAMEVALUE" value="false"/>
							<a:a name="UUID" 
								value="ECUC:44bb38ac-d409-4b1d-96be-ec84466c1019"/>
							<a:da name="DEFAULT" value="NULL_PTR"/>
							<a:da name="ENABLE" value="false"/>
						  </v:var>															  
						</v:ctr>							
                      </v:ctr>						  
					</v:ctr>	
                </v:ctr>
              </d:chc>
            </d:lst>
          </d:ctr>
        </d:lst>
      </d:ctr>
    </d:lst>
  </d:ctr>

</datamodel>
