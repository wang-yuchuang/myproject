LOCAL_DIR := $(GET_LOCAL_DIR)
CFLAGS_INC := $(GLOBAL_INCLUDES) $(IDE_MODULE_INCLUDE)
IDE_SRCS := $(ALLSRCS) $(IDE_MODULE_SRCS)

TOP_ROOT := $(realpath $(SSDK_ROOT))
IDE_OUT_DIR := $(TOP_ROOT)/$(BUILDDIR)

IDE_TEMPLATE_PATH := $(TOP_ROOT)/$(LOCAL_DIR)
IDE_PROJECT_TEMPLATE ?= $(IDE_TEMPLATE_PATH)/.project
IDE_CPROJECT_TEMPLATE ?= $(IDE_TEMPLATE_PATH)/.cproject
GENTOOL := $(IDE_TEMPLATE_PATH)/gen_rapidstudio_project.py

IDE_ROOTDIR= --rootdir  $(TOP_ROOT)
IDE_BOARD= --board $(BOARD)
IDE_PROJECT= --project $(PROJECT)
IDE_CORE= --core $(CORE)
IDE_TEMPLATE= --template $(IDE_TEMPLATE_PATH)
IDE_GLOBAL_OPTFLAGS = --GLOBAL_OPTFLAGS "$(GLOBAL_OPTFLAGS)"
IDE_GLOBAL_COMPILEFLAGS= --GLOBAL_COMPILEFLAGS "$(GLOBAL_COMPILEFLAGS) $(ARCH_COMPILEFLAGS) $(THUMBCFLAGS)"
IDE_GLOBAL_CFLAGS= --GLOBAL_CFLAGS "$(GLOBAL_CFLAGS)"
IDE_GLOBAL_ASMFLAGS= --GLOBAL_ASMFLAGS "$(GLOBAL_ASMFLAGS)"
IDE_SOURCE= --SOURCES "$(IDE_SRCS)"
IDE_INCLUDE= --INCLUDES "$(CFLAGS_INC)"
IDE_GLOBAL_LINKFLAGS= --LINKLIBS "$(GLOBAL_MODULE_LDFLAGS)"
IDE_LD_FLAG= --LINKLDS "$(GLOBAL_LDFLAGS) -dT XXXX$(LINKER_SCRIPT) $(addprefix -TXXXX,$(EXTRA_LINKER_SCRIPTS))"

rapidstudio: $(IDE_PROJECT_TEMPLATE) $(CONFIG_OUT_FILES) $(LINKER_SCRIPT)
	if [ ! -d $(IDE_OUT_DIR) ]; then mkdir -p $(IDE_OUT_DIR); fi
	
	@ python3 $(GENTOOL) $(IDE_ROOTDIR) $(IDE_BOARD) $(IDE_PROJECT) $(IDE_CORE) $(IDE_TEMPLATE) $(IDE_LD_FLAG) $(IDE_ROOTDIR) $(IDE_GLOBAL_OPTFLAGS) $(IDE_GLOBAL_COMPILEFLAGS) $(IDE_GLOBAL_CFLAGS) $(IDE_GLOBAL_ASMFLAGS) $(IDE_SOURCE) $(IDE_INCLUDE) $(IDE_GLOBAL_LINKFLAGS)

clean-env:
	rm -rf $(IDE_OUT_DIR)

