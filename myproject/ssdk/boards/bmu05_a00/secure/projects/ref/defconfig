# bmu05_a00 secure 模板 defconfig (ssdk-project-mode-unification D1)
#
# 内容 = 公共集 + bool 型模式差异项(y 态，以 XIP 侧为超集)。模式差异行由构建期
# 变体 defconfig 生成覆盖（design D2/D2a，见 variants/{emmc_only,xip}.conf）：
#   - 变体专属 int/string 行（MEM_BASE/MEM_SIZE/RAM_BASE/RAM_SIZE/TCM/IRAM/IPCC_BUFF_NUM）不落模板
#     （int 无法 'is not set' 关闭，必须由 fragment 追加/覆盖；MEM_BASE 由 calc BPT 派生）
#   - bool 差异项（XIP_MODE/EARLYCOPY/STR/MEDIA/UPDATE_FLASH/GPT_SLOT_SWITCH/DISK_NOR_FLASH/
#     ICCMSG_DEMO）模板置 y，emmc_only fragment 以 '# CONFIG_X is not set' 关闭
#   - emmc_only 产物 = 模板 + emmc_only.conf；xip(-s A/B) 产物 = 模板 + xip.conf + calc MEM_BASE
CONFIG_ARCH_EARLY_ENABLE_ICACHE=y
CONFIG_ARCH_EARLY_ENABLE_DCACHE=y
CONFIG_ARCH_USE_FPU=y
CONFIG_ARCH_USE_MPU=y
CONFIG_ARCH_FIQ_STACK_SIZE=256
CONFIG_ARCH_SVC_STACK_SIZE=2048
CONFIG_ARM_WITH_PMU=y
CONFIG_ARCH_CHIP_D9_SEC=y
CONFIG_ARCH_CHIP_D9=y
CONFIG_MAIN_THREAD_STACK_SIZE=4096
CONFIG_MAIN_THREAD_PRIORITY=2
CONFIG_SECURE=y

# === XIP 模式核心配置 (design.md D1, D2) ===
CONFIG_XIP_MODE=y
CONFIG_EARLYCOPY=y

# === 内存布局/链接参数：由 variants fragment + calc 派生，不落模板 (D2a/D2c) ===
# xip.conf:  CONFIG_MEM_SIZE=0x100000 + RAM_BASE/RAM_SIZE/TCMA/TCMB/IRAM 行 + calc 注入 MEM_BASE
# emmc_only.conf: CONFIG_MEM_BASE=0x140000 + CONFIG_MEM_SIZE=0xC0000 (ddr.ld 仅需 MEMBASE/MEMSIZE)

CONFIG_BOARD_REMAP=y
CONFIG_PROJECT_VERSION="V0.0.2"
CONFIG_FLEXCAN=y
CONFIG_DISPSS=y
CONFIG_KUNLUN_ADC=y
CONFIG_KUNLUN_CKGEN=y
