<?xml version='1.0'?>
<datamodel version="7.0" 
           xmlns="http://www.tresos.de/_projects/DataModel2/16/root.xsd" 
           xmlns:a="http://www.tresos.de/_projects/DataModel2/16/attribute.xsd" 
           xmlns:v="http://www.tresos.de/_projects/DataModel2/06/schema.xsd" 
           xmlns:d="http://www.tresos.de/_projects/DataModel2/06/data.xsd">

  <d:ctr type="AUTOSAR" factory="autosar" 
         xmlns:ad="http://www.tresos.de/_projects/DataModel2/08/admindata.xsd" 
         xmlns:cd="http://www.tresos.de/_projects/DataModel2/08/customdata.xsd" 
         xmlns:f="http://www.tresos.de/_projects/DataModel2/14/formulaexpr.xsd" 
         xmlns:icc="http://www.tresos.de/_projects/DataModel2/08/implconfigclass.xsd" 
         xmlns:mt="http://www.tresos.de/_projects/DataModel2/11/multitest.xsd"  
         xmlns:variant="http://www.tresos.de/_projects/DataModel2/11/variant.xsd">
    <d:lst type="TOP-LEVEL-PACKAGES">
      <d:ctr name="AUTOSAR" type="AR-PACKAGE">
        <a:a name="UUID" value="ECUC:AUTOSAR"/>
        <d:lst type="TOP-LEVEL-PACKAGES">
          <d:ctr name="EcucDefs" type="AR-PACKAGE">
            <a:a name="UUID" value="ECUC:ECUCDEFS"/>
            <d:lst type="ELEMENTS">
              <d:chc name="FuncSafetyPkg" type="AR-ELEMENT" value="MODULE-DEF">
                <v:ctr type="MODULE-DEF">
                  <a:a name="ADMIN-DATA" type="ADMIN-DATA">
                    <ad:ADMIN-DATA>
                      <ad:DOC-REVISIONS>
                        <ad:DOC-REVISION>
                          <ad:REVISION-LABEL>4.3.1</ad:REVISION-LABEL>
                          <ad:ISSUED-BY>AUTOSAR</ad:ISSUED-BY>
                        </ad:DOC-REVISION>
                      </ad:DOC-REVISIONS>
                    </ad:ADMIN-DATA>
                  </a:a>
                  <a:a name="DESC" 
                       value="EN: Configuration of the FuncSafetyPkg module."/>
                  <a:a name="LOWER-MULTIPLICITY" value="0"/>
                  <a:a name="POSTBUILDVARIANTSUPPORT" value="false"/>
                  <a:a name="RELEASE" value="asc:4.3.1"/>
                  <a:a name="UPPER-MULTIPLICITY" value="1"/>
                  <a:a name="UUID" 
                       value="ECUC:c41e9d3e-2da8-4985-a0ad-283ad8661088"/>
                  <v:var name="IMPLEMENTATION_CONFIG_VARIANT" 
                         type="ENUMERATION">
                    <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                         type="IMPLEMENTATIONCONFIGCLASS">
                      <icc:v vclass="PreCompile">VariantLinkTime</icc:v>
                      <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                    </a:a>
                    <a:a name="LABEL" value="Config Variant"/>
                    <a:da name="DEFAULT" value="VariantLinkTime"/>
                    <a:da name="RANGE">
                      <a:v>VariantLinkTime</a:v>
                      <a:v>VariantPreCompile</a:v>
                    </a:da>
                  </v:var>
                  <v:ctr name="FuncSafetyPkgCommon" type="IDENTIFIABLE">
                    <a:a name="DESC" 
                         value="EN: This container holds a list of all available functions in the FuncSafetyPkg module.  Each function is turned ON or OFF before compiling so that only the desired functions and test algorithms are in the compiled code."/>
                    <a:a name="UUID" 
                         value="ECUC:8e3b9850-bbd7-415a-a5bb-e6e4962cc5da"/>
					<v:var name="SelfTestPowerOn" type="BOOLEAN">
					  <a:a name="DESC" 
						   value="EN: Preprocessor switch to disable / enable the function."/>
					  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
						   type="IMPLEMENTATIONCONFIGCLASS">
						<icc:v vclass="PreCompile">VariantLinkTime</icc:v>
						<icc:v vclass="PreCompile">VariantPreCompile</icc:v>
					  </a:a>
					  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
					  <a:a name="SCOPE" value="LOCAL"/>
					  <a:da name="DEFAULT" value='true'/>
					  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
					  <a:a name="UUID" 
						   value="ECUC:16d97fa1-5ab2-41a9-af8c-3cda57200b97"/>
					</v:var>
					<v:var name="SelfTestPeriodic" type="BOOLEAN">
					  <a:a name="DESC" 
						   value="EN: Preprocessor switch to disable / enable the function for self test period."/>
					  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
						   type="IMPLEMENTATIONCONFIGCLASS">
						<icc:v vclass="PreCompile">VariantLinkTime</icc:v>
						<icc:v vclass="PreCompile">VariantPreCompile</icc:v>
					  </a:a>
					  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
					  <a:a name="SCOPE" value="LOCAL"/>
					  <a:da name="DEFAULT" value='true'/>
					  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
					  <a:a name="UUID" 
						   value="ECUC:16d97fa1-5ab2-41a9-af8c-3cda57200b97"/>
					</v:var>
					<v:ctr name="SelfTestPowerOnOptions" type="IDENTIFIABLE">
					    <a:a name="ENABLE" type="XPath" expr="node:value(../SelfTestPowerOn)= &quot;true&quot;"/>
						<a:a name="DESC" 
							 value="EN: This container holds a list of all available functions for self-test when ECUM power on in the FuncSafetyPkg module.  Each function is turned ON or OFF before compiling so that only the desired functions and test algorithms are in the compiled code."/>
						<a:a name="UUID" 
							 value="ECUC:8e3b9850-bbd7-415a-a5bb-e6e4962cc5de"/>						
						<v:var name="Iram1BitErrInjectPowerOn" type="BOOLEAN">
						  <a:a name="DESC" 
							   value="EN: Preprocessor switch to disable / enable the function which injects 1 bit error in Iram when ECU powers on."/>
						  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
							   type="IMPLEMENTATIONCONFIGCLASS">
							<icc:v vclass="PreCompile">VariantLinkTime</icc:v>
							<icc:v vclass="PreCompile">VariantPreCompile</icc:v>
						  </a:a>
						  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
						  <a:a name="SCOPE" value="LOCAL"/>		
						  <a:da name="DEFAULT" value='true'/>						  
						  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
						  <a:a name="UUID" 
							   value="ECUC:16d97fa1-5ab2-41a9-af8c-3cda57200b97"/>
						</v:var>
						<v:var name="Iram2BitErrInjectPowerOn" type="BOOLEAN">
						  <a:a name="DESC" 
							   value="EN: Preprocessor switch to disable / enable the function which injects 2 bits error in Iram when ECU powers on."/>
						  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
							   type="IMPLEMENTATIONCONFIGCLASS">
							<icc:v vclass="PreCompile">VariantLinkTime</icc:v>
							<icc:v vclass="PreCompile">VariantPreCompile</icc:v>
						  </a:a>
						  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
						  <a:a name="SCOPE" value="LOCAL"/>
						  <a:da name="DEFAULT" value='true'/>
						  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
