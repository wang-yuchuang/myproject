comment "Driver Example Options"

config USB_DEMO
    bool "USB Example Application Support"
    default n
    help
      USB example applications. Corresponding class drivers shall be enabled as well.

if USB_DEMO
rsource "usb/Kconfig"
endif # USB_DEMO

