	echo "[BOOT] mu3/run_app: APP_PID_FILE exists, already running, exiting!"
	exit 1;
fi


##added 20210602 for cleaning the cache/inode pages
sync
echo 3 > /proc/sys/vm/drop_caches

echo "[BOOT] mu3/run_app: starting nccu_app"
./bin/nccu_app -pid=$APP_PID_FILE >>$TRACE_LOG 2>>$TRACE_LOG &
NCCU_PID=$!
