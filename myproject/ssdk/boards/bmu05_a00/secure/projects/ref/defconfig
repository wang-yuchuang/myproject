CONFIG_KUNLUN_PINCTRL=y
CONFIG_SDRV_KUNLUN_PMU=y
CONFIG_DW_RTC=y
CONFIG_KUNLUN_SEM=y
CONFIG_DW_SPI=y
CONFIG_SDRV_SYSCNT=y
CONFIG_SDRV_TMR=y
CONFIG_DW_UART=y
CONFIG_SDRV_WDOG_KUNLUN=y
CONFIG_KUNLUN_MMC=y
CONFIG_PFM=y
CONFIG_MEMMAP=y
CONFIG_BUFFQUEUE_VRING_ALIGN=32
CONFIG_SD_CRC32=y
CONFIG_DEBUG_LEVEL=6
CONFIG_CDNS_OSPI=y
CONFIG_DISK_MMC=y
CONFIG_DISK_NOR_FLASH=y
CONFIG_DISK_NOR_FLASH_BYTES_API_SUPPORT=y
CONFIG_DISK_MAPPED=y
