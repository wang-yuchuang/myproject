						  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
						  <a:a name="UUID" 
							   value="ECUC:16d97fa1-5ab2-41a9-af8c-3cda57200b97"/>
						</v:var>	
                        <v:var name="IramErrInjectPeriodCnt" type="INTEGER">
						  <a:a name="ENABLE" type="XPath" expr="node:value(../../SelfTestPeriodic)= &quot;true&quot;
						  and (node:value(../../SelfTestPeriodicOptions/Iram1BitErrInjectPeriodic)= &quot;true&quot; or 		 node:value(../SelfTestPeriodicOptions/Iram2BitErrInjectPeriodic)= &quot;true&quot;)"/>								
                          <a:a name="DESC" 
                               value="EN: The period count for injecting 1/2 bits error in Iram periodically."/>
