comment "D9 Safety Core Options"

config MEM_BASE
    hex "Memory Start Address"
    default 0x38800000

config MEM_SIZE
    hex "Memory Size"
    default 0xf000000

config BOARD_REMAP
    bool "Enable Kunlun board remap"
    select SCR
    select RESETGEN
    select KUNLUN_RESETGEN
    default n
config KUNLUN_BOOT_MP
    bool "Boot MP Core"
    default n

config EARLYCOPY
    bool "early copy"
    default n