    default USE_GUI_LVGL
    depends on APP_LAUNCHER

config USE_GUI_LVGL
    bool "use lvgl gui"
    select GUI_LVGL
    select LVGL_SDRV_DISPLAY
    select LVGL_SDRV_DECODER_PNG
    select LVGL_SDRV_DECODER_JPG
    select LVGL_SDRV_FAT_FS
    select LVGL_SDRV_INPUT

config USE_QT_MCU
    bool "use qt mcu gui"
    select QT_FOR_MCU

config CLOSE_GUI
    bool "Do not use gui"

endchoice

