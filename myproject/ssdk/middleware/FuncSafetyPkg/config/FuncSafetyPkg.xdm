                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" 
                               value="ECUC:ea7f8f6d-5d98-4bc4-808e-dc02c4c233ac"/>
						  <a:da name="DEFAULT" value='2'/>	 	   
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=1"/>
                          </a:da>
                        </v:var>						
                        <v:var name="DualCoreLockStepInjectErrorPeriodCnt" type="INTEGER">
						  <a:a name="ENABLE" type="XPath" expr="(node:value(../../SelfTestPeriodic)= &quot;true&quot;) and (node:value(../../SelfTestPeriodicOptions/DualCoreLockStepInjectErrorPeriodic)= &quot;true&quot;)"/>				
						  <a:a name="DESC" 
                               value="EN: The period count for injecting error in dualcore lockstep periodically."/>
                          <a:a name="IMPLEMENTATIONCONFIGCLASS" 
                               type="IMPLEMENTATIONCONFIGCLASS">
                            <icc:v mclass="PostBuild">VariantPostBuild</icc:v>
                            <icc:v mclass="PreCompile">VariantPreCompile</icc:v>
                            <icc:v vclass="PostBuild">VariantPostBuild</icc:v>
                            <icc:v vclass="PreCompile">VariantPreCompile</icc:v>
                          </a:a>
                          <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
                          <a:a name="POSTBUILDVARIANTVALUE" value="true"/>
                          <a:a name="SCOPE" value="LOCAL"/>
                          <a:a name="SYMBOLICNAMEVALUE" value="false"/>
                          <a:a name="UUID" 
                               value="ECUC:ea7f8f6d-5d98-4bc4-808e-dc02c4c233ac"/>
						  <a:da name="DEFAULT" value='3'/>	 	   	   
                          <a:da name="INVALID" type="Range">
                            <a:tst expr="&lt;=255"/>
                            <a:tst expr="&gt;=1"/>
                          </a:da>
                        </v:var>						
					</v:ctr>				
					<v:ctr name="IramErrInjectConfigSet" type="IDENTIFIABLE">					
                      <a:a name="ENABLE" type="XPath" expr="(((node:value(../SelfTestPowerOn) = &quot;true&quot;)  and
					                                        ((node:value(../SelfTestPowerOnOptions/Iram1BitErrInjectPowerOn) = &quot;true&quot;)   or
					                                        (node:value(../SelfTestPowerOnOptions/Iram2BitErrInjectPowerOn) = &quot;true&quot;)))
															or
					                                       ((node:value(../SelfTestPeriodic) = &quot;true&quot;)   and
					                                       ((node:value(../SelfTestPeriodicOptions/Iram1BitErrInjectPeriodic) = &quot;true&quot;) or
															(node:value(../SelfTestPeriodicOptions/Iram2BitErrInjectPeriodic) = &quot;true&quot;)))) "/>																
					  <v:var name="IramInject1BitErrMode" type="ENUMERATION">
				      <a:a name="DESC" 
						   value="EN: Inject 1bit error mode for iram when ECU power on or off: INJECT_ALL_TRAVEL,INJECT_FIXED_POINT,the former takes more time than the latter"/>
					  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
						   type="IMPLEMENTATIONCONFIGCLASS">
						<icc:v vclass="PreCompile">VariantLinkTime</icc:v>
						<icc:v vclass="PreCompile">VariantPreCompile</icc:v>
					  </a:a>	
                      <a:a name="ENABLE" type="XPath" expr="(node:value(../../SelfTestPowerOn)= &quot;true&quot; and
					                                         node:value(../../SelfTestPowerOnOptions/Iram1BitErrInjectPowerOn)= &quot;true&quot;) or
					                                        (node:value(../../SelfTestPeriodic)= &quot;true&quot; and
					                                         node:value(../../SelfTestPeriodicOptions/Iram1BitErrInjectPeriodic)= &quot;true&quot;)"/>								
					  <a:a name="ORIGIN" value="AUTOSAR_ECUC"/>
					  <a:a name="SCOPE" value="ECU"/>
					  <a:a name="SYMBOLICNAMEVALUE" value="false"/>
					  <a:a name="UUID" 
						   value="ECUC:d596f059-d21f-46fa-8c62-8eae8ff3d68d"/>
					  <a:da name="DEFAULT" value='INJECT_FIXED_POINT'/>
					  <a:da name="RANGE">
						<a:v>INJECT_ALL_TRAVEL</a:v>
						<a:v>INJECT_FIXED_POINT</a:v>
					  </a:da>
					</v:var>
					<v:var name="IramInject2BitErrMode" type="ENUMERATION">
					  <a:a name="DESC" 
						   value="EN: Inject 2bit error mode for iram when ECU power on or off: INJECT_ALL_TRAVEL,INJECT_FIXED_POINT,the former takes more time than the latter"/>
