#!/bin/sh

#make type: debug/test/release/clean
export NCCU_MAKE_TYPE=$1
# LJH241101 MU3
export MU_TYPE=$2

#WLD01206 10inch LCD
export LCD_TYPE=$3

# to log the make result
MAKE_LOG_FILE=make_$2_$NCCU_CROSS_PLATFORM\_$1.log
MAKE_TARGET=

#added by zj --20250525
IMAGE_NAME="app_nccu"
MD5SUM_PKG_LOG_FILE="pkg.sum"


clean_pack()
{
	rm -f "${NCCU_PKG_DIR}/${IMAGE_NAME}"*
	rm -f "${NCCU_PKG_DIR}/${MD5SUM_PKG_LOG_FILE}"
	rm -f "${NCCU_IMG_DIR}/${IMAGE_NAME}"*
	
}

do_pack()
{
	## 打包输出.img 镜像
	## 手动烧录时使用.img文件，烧录命令如下：
	## dd if=app_nccu.img of=/dev/by-name/data_a bs=4k status=progress conv=fsync
	## dd if=app_nccu.img of=/dev/by-name/data_b bs=4k status=progress conv=fsync
	[ -d "$NCCU_PKG_DIR" ] || mkdir -p "$NCCU_PKG_DIR"
	[ -d "$NCCU_IMG_DIR" ] || mkdir -p "$NCCU_IMG_DIR"

	clean_pack

	MIN_IMAGE_SIZE=$(( 64 * 1024 * 1024 ))  # 最低64MB
	DIR_SIZE_BYTES=$(du -sb "$NCCU_TARGET_DIR" | awk '{print $1}')
	IMAGE_SIZE_BYTES=$(( DIR_SIZE_BYTES * 300 / 100 ))  # 增加200%冗余
	IMAGE_SIZE_BYTES=$(( IMAGE_SIZE_BYTES > MIN_IMAGE_SIZE ? IMAGE_SIZE_BYTES : MIN_IMAGE_SIZE ))
    BLOCK_COUNT=$(( (IMAGE_SIZE_BYTES + 4095) / 4096 ))

    ## 创建空白镜像
    IMAGE_PATH="${NCCU_PKG_DIR}/${IMAGE_NAME}.img"
    dd if=/dev/zero of="$IMAGE_PATH" bs=4k count="$BLOCK_COUNT" status=none || exit 1

    ## 使用 mkfs.ext4 -d 直接生成镜像（避免挂载）
    mkfs.ext4 -q -F -d "$NCCU_TARGET_DIR" -L "APP_DATA" "$IMAGE_PATH"

    ## 校验文件系统
    if ! fsck.ext4 -n "$IMAGE_PATH"; then
        echo "文件系统校验失败!"
        exit 1
    fi
	echo "d9 app 烧录镜像已生成: $NCCU_PKG_DIR/$IMAGE_PATH"
	
	#输出校验文件
	MD5SUM_PKG_SRC_FILE=$IMAGE_PATH
	
	md5sum "$MD5SUM_PKG_SRC_FILE" > "$MD5SUM_PKG_LOG_FILE"

	#打包.rpkg升级包
	# UPDATE_FILE_PATH="${NCCU_IMG_DIR}/${IMAGE_NAME}_${CURRENT_TIME}.rpkg"
	UPDATE_FILE_PATH="${NCCU_IMG_DIR}/${IMAGE_NAME}.rpkg"
	
	tar -cvzf "$UPDATE_FILE_PATH" "$IMAGE_PATH" "$MD5SUM_PKG_LOG_FILE"
	echo "d9 app 升级镜像已生成: $UPDATE_FILE_PATH"
}


# to make debug version
if [ "$1" = "debug" ]; then
	if [ ! -f $MAKE_LOG_FILE ]; then
		# If other version just maked, the all objects shall be cleaned.
		make clean > /dev/null 2>&1
		rm -f make_*.log
	fi

# to make release version
elif [ "$1" = "release" ]; then
	if [ ! -f $MAKE_LOG_FILE ]; then
		# If a other version just maked, the all objects shall be cleaned.
		make clean > /dev/null 2>&1
		rm -f make_*.log
	fi
	
#to make self-test program or test makefiles
elif [ "$1" = "test" ]; then
	#export NCCU_MAKE_VERSION=debug
	if [ ! -f $MAKE_LOG_FILE ]; then
		# If other version just maked, the all objects shall be cleaned.
		make clean > /dev/null 2>&1
		rm -f make_*.log
	fi

	MAKE_TARGET=test
	
# do clean
elif [ "$1" = "clean" ]; then
	echo Cleaning...
	make clean > /dev/null 2>&1
	clean_pack
	echo Clean done.
	exit 0		

# do install, install all files to target	
elif [ "$1" = "install" ]; then
	echo Installing...
	make install
	echo -e "\e[32mInstall done.\e[0m"
#	do_pack

	exit 0

# do install, install all files to target, including updates for BSP	
elif [ "$1" = "install_with_bsp" ]; then
	echo Installing with bsp package...
	make install
	echo Install done, BSP is also included.
	exit 0

# do install, install all files to target, including updates for BSP, only for sh	
elif [ "$1" = "install_with_bsp_sh" ]; then
	echo Installing with bsp package, only for sh...
	make install
	echo Install done, BSP sh is also included.
	exit 0

# do install, install all files to target, including updates for BSP, only for font	
elif [ "$1" = "install_with_bsp_font" ]; then
	echo Installing with bsp package, only for font...
	make install
	echo Install done, BSP font is also included.
	exit 0

# do install, install with ccu-bin file inclueded
elif [ "$1" = "install_with_ccubin" ]; then
	echo Installing with ccu-bin...
	make install
	echo Install done, ccu-bin is also included.
	exit 0
#error args
else 
	echo "Usage: $0 <debug | release | clean | test>"
	echo "       $0 debug  : To make debug version"
	echo "       $0 release: To make release version"
	echo "       $0 clean  : To clean all files generated by make"
	echo "       $0 test   : To test the Makefiles"
	exit 0
fi

#now, do the making progress

rm -f $MAKE_LOG_FILE
echo "************************************"
echo Now begin making [$1] version for [$MU_TYPE-$NCCU_CROSS_PLATFORM] platform...
echo "************************************"

echo "****************************************************" >> $MAKE_LOG_FILE
echo "*** Making $1 version for [$MU_TYPE-$NCCU_CROSS_PLATFORM] platform..." >> $MAKE_LOG_FILE
echo "*** Making start at `date`" >> $MAKE_LOG_FILE
echo >> $MAKE_LOG_FILE


make $MAKE_TARGET >> $MAKE_LOG_FILE 2>&1

echo >> $MAKE_LOG_FILE
echo -e "\e[32m*** Making [$MU_TYPE-$NCCU_CROSS_PLATFORM-$1] end at `date`\e[0m" >> $MAKE_LOG_FILE
echo "****************************************************" >> $MAKE_LOG_FILE

cat $MAKE_LOG_FILE

echo
echo "*****"
echo "***** For further the compiling message, to read the file \"$MK_RESULT_FILE\""
echo "*****"
echo
