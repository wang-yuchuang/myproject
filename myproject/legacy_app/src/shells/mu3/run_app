########### add log4c lib ######
test -e /app/extensions/log4crc && cp -f /app/extensions/log4crc /opt/appdata/config/log4crc 2>/dev/null || true
# 如果 /opt/appdata/config/log4crc 不存在，兜底拷贝到 /etc
test -e /opt/appdata/config/log4crc || { test -e /app/extensions/log4crc && cp -f /app/extensions/log4crc /etc/log4crc 2>/dev/null || true; }
mkdir -p $(dirname $TRACE_LOG)

#--------------------------------add by Jimmy Wu for starting another process 'systemhandler'
echo "[BOOT] mu3/run_app: checking syshand (ps)"
if pidof syshand >/dev/null 2>&1; then
	echo
	echo !!!!!!!The sys_hand is ALREADY running!!!!!!!!
	echo
	# syshand 已在运行，确保 syshand.run 标记文件存在（nccu_app 需要）
	test -e /opt/appdata/data/syshand.run || touch /opt/appdata/data/syshand.run
else
	echo
	echo Starting SYSTEM_HANDLER...
	echo "[BOOT] mu3/run_app: starting syshand"
./bin/syshand &
	sleep 1
fi

#wait install done
IS_EXT_INSTALLING=`ps | grep /app/extensions/install.sh | grep -v grep`
if [[ -n "$IS_EXT_INSTALLING" ]]; then
	wait=1
	while [ $wait -le 50 ]
	do
		IS_EXT_INSTALLING=`ps | grep /app/extensions/install.sh | grep -v grep`
		if [[ -z "$IS_EXT_INSTALLING" ]]; then
			echo "install ext done........"
			#when done, just sleep 1 sec more
			sleep 1
			break
		else
			echo "installing ext.........."
		fi
		let wait++
		usleep 100000
	done
fi

echo "[BOOT] mu3/run_app: checking syshand alive"
IS_SYSHAND_ALIVE=`ps | grep bin/syshand | grep -v grep`
if [[ -z "$IS_SYSHAND_ALIVE" ]]; then
	echo "[BOOT] mu3/run_app: syshand NOT alive, exiting!"
	exit 0;
fi
echo "[BOOT] mu3/run_app: syshand alive, skipping PID file check (process-based)"


