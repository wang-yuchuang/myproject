						</v:var>	
						<v:var name="FSRefClkSafeChkApPowerOn" type="BOOLEAN">
						  <a:a name="DESC" 
							   value="EN: Preprocessor switch to disable / enable the function(Fail safe reference clock:Safe clock check Ap clock)."/>
						  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
							   type="IMPLEMENTATIONCONFIGCLASS">
							<icc:v vclass="PreCompile">VariantLinkTime</icc:v>
							<icc:v vclass="PreCompile">VariantPreCompile</icc:v>
						  </a:a>
