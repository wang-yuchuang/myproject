comment "TjpgDec Options"

config JD_SZBUF
    int "Specifies size of stream input buffer"
    default 512

config JD_FORMAT
    int "Specifies output pixel format"
    default 0
    ---help---
        Specifies output pixel format.
            0: RGB888 (24-bit/pix)
            1: RGB565 (16-bit/pix)
            2: Grayscale (8-bit/pix)

config JD_USE_SCALE
    int "Specifies the output scaling feature"
    default 0
    ---help---
        Switches output descaling feature.
            0: Disable
            1: Enable

config JD_TBLCLIP
    int "Specifies the clip method"
    default 1
    ---help---
        Use table conversion for saturation arithmetic. A bit faster, but increases 1 KB of code size.
            0: Disable
            1: Enable

config JD_FASTDECODE
    int "Specifies the optimization level"
    default 2
    ---help---
        Optimization level
            0: Basic optimization. Suitable for 8/16-bit MCUs.
            1: + 32-bit barrel shifter. Suitable for 32-bit MCUs.
            2: + Table conversion for huffman decoding (wants 6 << HUFF_BIT bytes of RAM)