comment "D3 SF Core Options"

config MEM_BASE
    hex "Memory Start Address"
    default 0x404000

config MEM_SIZE
    hex "Memory Size"
    range 0 IRAM_LIMIT
    default 0x3FC000

config IRAM_NONE_ECC_BASE
    hex "IRAM NONE-ECC Base Address"
    default 0x800000

config IRAM_NONE_ECC_SIZE
    hex "IRAM NONE-ECC Size"
    default 0x80000

config EARLYCOPY
    bool "Early Copy sections from LMA to VMA"
    default y

config WORK_ON_Z1
    bool "Work on Z1"
    default n

config CLOCK_OVER_DRIVE_MODE
    bool "Clock over drive mode"
    default n

config HEAP_ON_SDRAM
    bool "Heap on SDRAM"
    depends on SDRV_SDRAMC
    default n

config BOARD_DEBUG
    bool "Enable CR5 debug"
    select CORE_DEBUG
    select TAISHAN_CORE_DEBUG
    default n

config FIX_LDO_1V8
    bool "Fix internal 1.8V LDO output"
    default y

config BOARD_REMAP
    bool "Do Remap When Early Init"
    select RESETGEN
    default n