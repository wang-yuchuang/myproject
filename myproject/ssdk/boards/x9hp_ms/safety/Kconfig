comment "X9 Safety Core Options"

config MEM_BASE
    hex "Memory Start Address"
    default 0x37200000

config MEM_SIZE
    hex "Memory Size"
    default 0x10000000

config RES_SIZE
    hex "Res Size"
    default 0x0

config BOARD_REMAP
    bool "Enable Kunlun board remap"
    select SCR
    select RESETGEN
    select KUNLUN_RESETGEN
    default n

config KUNLUN_BOOT_MP
    bool "Boot MP Core"
    default n

config EARLYCOPY
    bool "Early Copy sections from LMA to VMA"
    default y
