						<v:ctr name="WdtSelfTest" type="IDENTIFIABLE">
							<a:a name="DESC" 
								value="EN: This container contains configurations for wdt self test."/>
							<a:a name="UUID" 
								value="ECUC:62eb25f3-28ac-452e-a2fa-0f92357c16a6"/>			
							<v:var name="OverFlowValue" type="INTEGER">
							  <a:a name="DESC" 
								   value="EN: A 32bit overflow value is divided into four bytes in self-test mode, and we set this value so that all four bytes are the same "/>
							  <a:a name="IMPLEMENTATIONCONFIGCLASS" 
								   type="IMPLEMENTATIONCONFIGCLASS">
								<icc:v vclass="PreCompile">VariantLinkTime</icc:v>
								<icc:v vclass="PreCompile">VariantPreCompile</icc:v>
							  </a:a>
