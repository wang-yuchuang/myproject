LOCAL_DIR := $(GET_LOCAL_DIR)

ifeq ($(CONFIG_USBD_DEMO_HID), y)
MODULE_DEPS += $(LOCAL_DIR)/USBD_HID
endif

ifeq ($(CONFIG_USBD_DEMO_MSC), y)
MODULE_DEPS += $(LOCAL_DIR)/USBD_MSC
endif

ifeq ($(CONFIG_USBD_DEMO_FB), y)
MODULE_DEPS += $(LOCAL_DIR)/USBD_FB
endif

ifeq ($(CONFIG_USBD_DEMO_CDC_ACM), y)
MODULE_DEPS += $(LOCAL_DIR)/USBD_Serial
endif

ifeq ($(CONFIG_USBH_DEMO_HID_MSC), y)
MODULE_DEPS += $(LOCAL_DIR)/USBH_HID_MSC
endif

ifeq ($(CONFIG_USB_DEMO_OTG), y)
MODULE_DEPS += $(LOCAL_DIR)/USB_OTG
endif
